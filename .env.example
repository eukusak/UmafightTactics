# Local npm run dev / start:local: leave empty for same-origin localhost.
# Render Static Site: required at BUILD time. Public WebSocket URL, never internal host.
VITE_MULTIPLAYER_URL=
# Multiplayer production server: exact frontend origins, comma-separated, no trailing slash.
# ALLOWED_ORIGINS=https://umafight-frontend.onrender.com
# ENABLE_SERVER_METRICS=true
