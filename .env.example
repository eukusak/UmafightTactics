# Integrated npm start / local dev: leave empty for same-origin multiplayer.
# Render Static Site: required at BUILD time. Public WebSocket URL, never internal host.
VITE_MULTIPLAYER_URL=
# Production: exact frontend origins, comma-separated, no trailing slash.
# Integrated Render automatically adds RENDER_EXTERNAL_URL; custom domains must be listed.
# Split start:server always requires ALLOWED_ORIGINS.
# ALLOWED_ORIGINS=https://umafight-frontend.onrender.com
# ENABLE_SERVER_METRICS=true
